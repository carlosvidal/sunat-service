# --- API ---
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Clave maestra de la plataforma (administración de empresas): X-API-Key
MASTER_API_KEY=cambiar-esta-clave
# Secreto con el que se firman los tokens JWT de cada empresa
JWT_SECRET=cambiar-este-secreto

# --- PostgreSQL ---
DATABASE_URL=postgres://sunat:sunat@localhost:5434/sunat
DATABASE_SSL=false

# --- Redis / BullMQ (opcional: habilita /enqueue y el worker) ---
REDIS_URL=redis://localhost:6380

# --- Cifrado de secretos en reposo ---
# local = AES-256-GCM con SECRETS_MASTER_KEY | kms = AWS KMS (requiere implementar KmsVault)
SECRETS_DRIVER=local
# openssl rand -base64 32
SECRETS_MASTER_KEY=
KMS_KEY_ID=
AWS_REGION=us-east-1

# --- Almacenamiento de XML / CDR / PDF ---
STORAGE_DRIVER=local
STORAGE_PATH=./storage
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# --- SUNAT ---
SUNAT_TIMEOUT_MS=45000

# --- Webhook por defecto (puede sobreescribirse por empresa) ---
WEBHOOK_URL=
WEBHOOK_SECRET=

# --- Worker ---
WORKER_CONCURRENCY=5
